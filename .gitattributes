# Rule files are ordinary Python modules, loaded explicitly by the analyzer.
*.py linguist-language=Python diff=python

# Demo GIFs exist for the docs as GitHub renders them, but `git archive` builds
# the release asset, so they were landing in every user's program folder: 8.3 MB
# of a 12.8 MB install that nothing at runtime reads.
img/** export-ignore

# The repo is edited on Linux and from Windows VMs over a shared folder; pin LF
# so neither side's core.autocrlf rewrites every line. cmd.exe needs CRLF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.gif binary

# The export fixture is byte-level test input/output, including native XML.
products/codesys-agent/tests/Cts.Agent.Core.Tests/Golden/ExportFixture/** -text

# The prebuilt in-IDE agent is build output a download from a branch installs
# without a .NET SDK; Git LFS keeps each refresh out of the history a clone pulls.
products/codesys-agent/dist/*.dll filter=lfs diff=lfs merge=lfs -text
products/codesys-agent/dist/*.exe filter=lfs diff=lfs merge=lfs -text
