  "properties": {
    "source": {"enum": ["project", "library"]},
    "kind": {"type": "string"},
    "name": {"type": "string"},
    "path": {"type": "string"},
    "line": {"type": ["integer", "null"]},
    "interface": {"type": "array"},
    "description": {"type": "string"},
    "library": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]}
  }
}
