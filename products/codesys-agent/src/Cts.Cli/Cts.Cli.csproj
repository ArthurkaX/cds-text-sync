<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48: every PC that runs CODESYS has it, so cts.exe needs no runtime of its own. -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>cts</AssemblyName>
    <RootNamespace>Cts.Cli</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cts.Agent.Core\Cts.Agent.Core.csproj" />
  </ItemGroup>
</Project>
