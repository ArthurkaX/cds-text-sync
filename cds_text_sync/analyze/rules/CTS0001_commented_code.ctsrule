from cds_text_sync.analyze.rules_api import RuleSpec

RULE = RuleSpec(
    id="CTS0001",
    title="Commented-out code",
    severity="suspicious",
    scope=Scope.UNIT,
    requires={Capability.ST_TEXT},
    kinds="CALLABLE",
    summary="ST statements that survive inside comments.",
    topic="Code quality",
    check=check,
)
